# ShopAlly Backend Environment Configuration (Template)

# Server
SERVER_PORT=10000
SERVER_ENV=production

# CORS (Frontend origin that is allowed to access this API)
CORS_ALLOWED_ORIGINS=https://shopally-web.vercel.app

# Authentication (Must match the AUTH_JWT_SECRET in your frontend .env.local)
AUTH_JWT_SECRET=your-32-char-min-secret-key-here

# MongoDB Atlas
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DATABASE=shopally

# Redis (Upstash or Cloud Redis)
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=true
